Options -Indexes

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php[0-9]?|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php[0-9]?|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
