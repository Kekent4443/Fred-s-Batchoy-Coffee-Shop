# Local credentials and private runtime data (allow only reviewed templates).
/database/
/private/*
!/private/.htaccess
!/private/*.example.php
!/private/admin-access.php
!/private/uploads/
/private/uploads/**
!/private/uploads/.htaccess
.env
.env.*
!.env.example
*.local.php
auth.json
.netrc
.npmrc
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
id_rsa*
id_ed25519*

# Keep upload access controls, never customer IDs, proofs, QR codes or photos.
/public/uploads/**
!/public/uploads/**/
!/public/uploads/**/.htaccess

# Reinstall dependencies with Composer; keep assets/js/vendor source assets.
/vendor/
node_modules/

# Browser profiles, reports, exports, backups and local scratch files.
/tmp/
/temp/
/output/
/coverage/
/backups/
/database/backups/
*.log
*.bak
*.orig
*.swp
*.sql.gz
*.sql.zip
*.zip
*.7z
*.tar
*.gz
.phpunit.cache/
.phpunit.result.cache
__pycache__/
*.pyc
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
